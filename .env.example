# ==============================================================================
# inboxHero Environment Configuration Template
# Copy this file to .env and configure for your setup.
# ==============================================================================

# --- Model Provider ---
# Options: "none" (default: deterministic rules and grounded templates), "gemini", "openai", "ollama"
INBOXHERO_PROVIDER=none

# Seconds between model calls. ~15 req/min free tiers need about 4s.
INBOXHERO_CALL_GAP=4.0

# --- Google Gemini Configuration ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI Configuration ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (Local LLM) Configuration ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --- Mailbox Owner and Paths ---
INBOXHERO_INBOX=inbox.json
INBOXHERO_OWNER=sam@paperjet.io
INBOXHERO_OWNER_NAME=Sam
